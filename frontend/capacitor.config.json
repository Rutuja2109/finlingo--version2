{
  "appId": "com.finlearnindia.app",
  "appName": "FinLearn",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.googleusercontent.com"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "bundledWebRuntime": false,
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
